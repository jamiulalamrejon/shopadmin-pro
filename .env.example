# ------------------------------------------------------------
# Developed by www.Jamiulalamrejon.com (https://www.Jamiulalamrejon.com)
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local to git.
# ------------------------------------------------------------

# Required: random secret (min 32 chars) used to sign login sessions.
# Generate one with:  npm run gen-secret
AUTH_SECRET=

# Session lifetime in hours
SESSION_HOURS=8

# Only for testing `npm start` on plain http://localhost. Keep false on a real server (use HTTPS).
ALLOW_INSECURE_HTTP=false

# ---------- SMS ----------
# demo | twilio | bulksmsbd   (demo = logs only, nothing is sent)
SMS_PROVIDER=demo
SMS_SENDER_ID=
# BulkSMSBD (or any compatible Bangladeshi gateway)
SMS_API_URL=http://bulksmsbd.net/api/smsapi
SMS_API_KEY=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- AI ----------
# demo | anthropic | openai   (demo = canned responses, no API calls)
AI_PROVIDER=demo
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
